{{!--
  registry_enum: one variant per item, with ALL, name(), from_name() and Display.
  Parameters: enum (type name), items (a group). Optional: derive (extra derives).
--}}
/// One variant per registered type, generated by impl-scan.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord{{#if derive}}, {{derive}}{{/if}})]
pub enum {{enum}} {
{{#each items}}
    {{doc doc fallback=type indent=4}}
    {{pascal name}},
{{/each}}
}

impl {{enum}} {
    /// Every variant, sorted by registered name.
    pub const ALL: &'static [{{enum}}] = &[{{#each items}}{{../enum}}::{{pascal name}}, {{/each}}];

    /// The registered name of this variant.
    pub const fn name(self) -> &'static str {
        match self {
{{#each items}}
            {{../enum}}::{{pascal name}} => {{quote name}},
{{/each}}
        }
    }

    /// Looks a variant up by registered name or alias.
    pub fn from_name(name: &str) -> ::core::option::Option<Self> {
        match name {
{{#each items}}
            {{quote name}}{{#each aliases}} | {{quote this}}{{/each}} => ::core::option::Option::Some({{../enum}}::{{pascal name}}),
{{/each}}
            _ => ::core::option::Option::None,
        }
    }
}

impl ::core::fmt::Display for {{enum}} {
    fn fmt(&self, f: &mut ::core::fmt::Formatter<'_>) -> ::core::fmt::Result {
        f.write_str(self.name())
    }
}
