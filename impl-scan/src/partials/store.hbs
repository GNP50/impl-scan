/// One map per registered type, keyed by `{{key}}`, generated by impl-scan.
#[derive(Default)]
pub struct {{store}} {
{{#each items}}
    {{snake name}}: ::std::collections::HashMap<{{../key}}, {{path}}>,
{{/each}}
}

