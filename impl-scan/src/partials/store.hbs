{{/each}}
    /// Which registered type is stored under `id`.
    pub fn kind_of(&self, id: &{{key}}) -> ::core::option::Option<{{enum}}> {
{{#each items}}
        if self.{{snake name}}.contains_key(id) {
            return ::core::option::Option::Some({{../enum}}::{{pascal name}});
        }
{{/each}}
        let _ = id;
        ::core::option::Option::None
    }

    /// The value stored under `id` as `&dyn {{trait}}`, if it is a `kind`.
    pub fn get(&self, kind: {{enum}}, id: &{{key}}) -> ::core::option::Option<&dyn {{trait}}> {
        match kind {
{{#each items}}
            {{../enum}}::{{pascal name}} => self.{{snake name}}.get(id).map(|v| v as &dyn {{../trait}}),
{{/each}}
        }
    }

    /// The value stored under `id` as `&mut dyn {{trait}}`, if it is a `kind`.
    pub fn get_mut(&mut self, kind: {{enum}}, id: &{{key}}) -> ::core::option::Option<&mut dyn {{trait}}> {
