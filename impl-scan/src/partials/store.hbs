    /// Stores a `{{type}}` under `id`, replacing whatever `id` held before.
    /// Returns the previous `{{type}}`, if `id` held one.
    pub fn insert_{{snake name}}(&mut self, id: {{../key}}, value: {{path}}) -> ::core::option::Option<{{path}}> {
        if self.kind_of(&id) != ::core::option::Option::Some({{../enum}}::{{pascal name}}) {
            self.remove(&id);
